{
  "name": "finch-mysql",
  "version": "0.3.20",
  "private": true,
  "description": "Finch — a fast, beautiful MySQL workbench for macOS.",
  "author": "Finch",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "dev:web": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:query-client": "node scripts/test-query-client.cjs",
    "app:dev": "tauri dev",
    "app:build": "tauri build --bundles app",
    "package:mac": "tauri build --bundles app,dmg",
    "preview": "vite preview",
    "test:ai-stream": "node scripts/test-ai-stream.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run typecheck && npm run test:ai-stream && npm run test:query-client && npm run test:rust"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.37.1",
    "@tanstack/react-virtual": "^3.13.9",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.6.6",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
