{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finch",
  "version": "0.5.0",
  "identifier": "com.finch.sql",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finch",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f3f2ee"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, local-first MySQL workbench.",
    "longDescription": "Finch is a local-first MySQL workbench for macOS with AI-assisted SQL, schema-aware generation, safe data sync, table design, and high-performance virtualized results.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
